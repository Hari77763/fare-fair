# ==============================================================================
# FairFare Environment Configuration Template
# Copy to .env and configure appropriate values for your environment.
# ==============================================================================

# Core System Settings
ENV=development
DEBUG=True
PROJECT_NAME="FairFare"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL + asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/fairfare"
SUPABASE_URL=""
SUPABASE_KEY=""

# Redis Cache & Message Broker
REDIS_URL="redis://localhost:6379/0"

# Security & Authentication (Generate a strong 64-char key in production)
# Leave empty in development (a random key is generated per process).
# REQUIRED in production: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
API_RATE_LIMIT_PER_MINUTE=60

# Supplier API Integration Defaults
SUPPLIER_DEFAULT_TIMEOUT_SECONDS=15
SUPPLIER_MAX_RETRIES=3

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Supplier API Credentials (Sandbox / Commercial Partners)
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
TRAVELPORT_TARGET_BRANCH=""
TRAVELPORT_CREDENTIALS=""
WEGO_API_KEY=""

# ------------------------------------------------------------------------------
# Live fares (frontend server routes: /api/fares, /api/fares/calendar)
# Set these in Vercel → Project → Settings → Environment Variables, or in
# frontend/.env.local for local development. Never prefix with NEXT_PUBLIC_.
# Without TRAVELPAYOUTS_TOKEN the site runs on clearly-labelled demo data.
# ------------------------------------------------------------------------------
TRAVELPAYOUTS_TOKEN=""      # Travelpayouts → Profile → API token
TRAVELPAYOUTS_MARKER=""     # Optional: your affiliate marker (adds commission tracking to booking links)
TRAVELPAYOUTS_MARKET=""     # Optional: data market, e.g. "in"; leave empty for the default
